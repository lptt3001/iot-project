{
  "name": "ptit-garden",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "browser": { "binding": "BROWSER" },
  "vars": { "APP_ORIGIN": "https://ptit-garden.hieunao96.workers.dev" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "assets": {
    "directory": ".build/dashboard-assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "ratelimits": [
    {
      "name": "DASHBOARD_LOGIN_LIMIT",
      "namespace_id": "30101",
      "simple": { "limit": 8, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ptit-garden",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "triggers": { "crons": ["0 * * * *", "*/5 * * * *"] }
}
